# K6 Performance Testing Environment Configuration
# Copy this file to .env and update with your values

# Test Configuration
ENVIRONMENT=dev
TEST_PROFILE=smoke
TEST_FILE=tests/google/google-api-test.js
DEBUG=false
LOG_LEVEL=info

# VPN Configuration (Optional)
VPN_USERNAME=your_vpn_username
VPN_PASSWORD=your_vpn_password
VPN_CONFIG=russia

# Windscribe Proxy Configuration (Optional)
WINDSCRIBE_USERNAME=your_windscribe_username
WINDSCRIBE_PASSWORD=your_windscribe_password
WINDSCRIBE_COUNTRY=US
PROXY_PORT=8888

# Monitoring Configuration
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=password123
INFLUXDB_ORG=k6-org
INFLUXDB_BUCKET=k6-metrics
INFLUXDB_TOKEN=k6-token-123
INFLUXDB_URL=http://influxdb:8086

GRAFANA_PASSWORD=admin123

# External Monitoring (Optional)
PROMETHEUS_URL=
EXTERNAL_INFLUXDB_URL=
